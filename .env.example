# Public, build-time (set as GitHub Actions variables, not secrets)
# Required in production builds: without it the form shows the email (mailto) fallback (success is simulated only in `next dev`)
# Set NEXT_PUBLIC_INTAKE_URL and NEXT_PUBLIC_TURNSTILE_SITE_KEY together: the Worker always verifies Turnstile
NEXT_PUBLIC_INTAKE_URL=https://intake.<your-subdomain>.workers.dev
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
